# ============================================================
# .gitignore — GASNexus (Racine du projet)
# ============================================================

# ---- NODE / ELECTRON ----
node_modules/
dist/
out/
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- NEXT.JS (frontend/) ----
frontend/.next/
frontend/out/
frontend/node_modules/
frontend/dist/
frontend/.vercel
frontend/tsconfig.tsbuildinfo
frontend/next-env.d.ts

# ---- PYTHON / BACKEND ----
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/*.egg-info/
backend/dist/
backend/.pytest_cache/

# ---- BASE DE DONNÉES LOCALE ----
# La DB SQLite locale ne doit PAS être versionnée
*.db
*.sqlite
*.sqlite3

# ---- FICHIERS STATIQUES UPLOADÉS ----
# Les images et logos uploadés par les utilisateurs
backend/static/uploads/

# ---- VARIABLES D'ENVIRONNEMENT ----
.env
.env.*
!.env.example
backend/.env
frontend/.env.local
frontend/.env*.local

# ---- RAPPORTS & FICHIERS GÉNÉRÉS ----
*.pdf
*.xlsx
*.xls
scratch/
tmp/
**/scratch/
**/tmp/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- ÉDITEURS ----
.vscode/
.idea/
*.swp
*.swo

# ---- LOGS ----
*.log
logs/

# ---- CERTIFICATS ----
*.pem
*.key
*.cert
