{
  "name": "frontend",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "nexus:client": "electron ./electron/client.js",
    "nexus:master": "electron ./electron/master.js",
    "electron-build": "next build && electron-builder --publish never",
    "electron-publish": "next build && electron-builder --publish always"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.gas.nexus",
    "productName": "GASNexus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "public/logo_premium.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "license.txt",
      "multiLanguageInstaller": true,
      "languages": [
        "fr_FR",
        "en_US"
      ],
      "deleteAppDataOnUninstall": true,
      "uninstallDisplayName": "Désinstaller GASNexus"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "renemakoule",
        "repo": "systeme_gestion_multicommerce",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.16",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "libphonenumber-js": "^1.12.41",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-phone-number-input": "^3.4.16",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/debug": "^4.1.13",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
